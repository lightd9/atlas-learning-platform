    "next": "^15.3.6",
    "next-auth": "beta",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "latest",
    "eslint": "^9",
    "eslint-config-next": "^15.3.6",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.3",
    "tsx": "latest",
